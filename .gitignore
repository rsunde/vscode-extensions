# VS Code Extensions Repository .gitignore

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build outputs
out/
dist/
*.vsix
*.js.map

# TypeScript
*.tsbuildinfo

# VS Code
.vscode/
.vscode-test/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE files
.idea/
*.iml
*.swp
*.swo
*~

# Logs
logs/
*.log

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Environment variables
.env
.env.local
.env.*.local

# PowerShell
*.ps1.bak
